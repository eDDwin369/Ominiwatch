# --- Server ---
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# Paste your connection string here (never commit it).
# Example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/help
DATABASE_SCHEMA=public

# --- Auth ---
# REQUIRED. There is no default on purpose: a committed placeholder becomes a
# known signing key on every deployment that forgot to override it.
# Generate one per deployment:  openssl rand -base64 48
#
# This service does not issue tokens. It verifies bearer tokens against this
# secret, so it must match whatever the host system signs with.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Object storage (Upstash Blob) ---
# REQUIRED. A read/write token for the blob bucket. Upstash hands the AWS SDK an
# endpoint and short-lived credentials through it, so there is no long-lived key
# pair anywhere.
#
# Uploads are presigned: the browser PUTs bytes straight to the bucket and no
# file passes through this process.
UPSTASH_BLOB_TOKEN=

# --- AI chat (OpenRouter) ---
# REQUIRED. Server-side only: the key is never sent to the browser.
OPENROUTER_API_KEY=
# Fixed by the service so a caller cannot select an expensive model.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

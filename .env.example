# Help Management API client config (Vite exposes VITE_* to the browser).

# Base URL of the API service (api/). Leave EMPTY for the default same-origin
# setup: `vite.config.ts` proxies /api -> http://localhost:3100 in development,
# and `nginx.conf` proxies /api -> the api service in production.
VITE_HELP_API_URL=

# Dev bearer token accepted by the API. The API issues no tokens of its own; it
# verifies them against JWT_SECRET, so this must be minted out-of-band for the
# seeded superadmin user (see api/README.md). Without it the help UI stays in
# local-only mode.
VITE_HELP_API_TOKEN=

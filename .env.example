# ==========================================
# Backend API Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://neondb_owner:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication
# Generate 32+ char secret with: openssl rand -base64 48
JWT_SECRET=your_secure_32_character_plus_jwt_secret_key_here
JWT_EXPIRES_IN=8h

# Object Storage (Upstash Blob)
UPSTASH_BLOB_TOKEN=AgAkADAMMGExNjIwMDgtODdhNi00OTJhLTg0YzItN2U5YWUzODk3ODRmTlRSbU56azNaVFF0WkRWak5pMDBORGcyTFdJMU1HRXRZek5oWldFM016TTVabUk1Yjc2OWI3YmI1YTJm

# AI Chat Service (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

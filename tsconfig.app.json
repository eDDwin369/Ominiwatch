{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@help/*": ["./src/help-app/*"],
      "@tanstack/react-router": ["./src/help-app/lib/router-shim.tsx"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // The Help Management app under `src/help-app/` is vendored from its own
    // standalone project, which shipped with these checks off. Host code (the
    // rest of `src/`) is written clean; leaving these off project-wide avoids
    // touching vendored files. Tracked as follow-up to tighten later.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
